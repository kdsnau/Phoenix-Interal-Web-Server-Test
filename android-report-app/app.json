{
  "expo": {
    "name": "PHX Field Reports",
    "slug": "phx-field-reports",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0e18",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b0e18"
      },
      "package": "com.phoenixsectech.fieldreports",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "defaultChannel": "report-reminders"
        }
      ],
[
        "expo-image-picker",
        {
          "photosPermission": "Allow PHX Field Reports to attach photos to reports.",
          "cameraPermission": "Allow PHX Field Reports to take job site photos."
        }
      ],
      "expo-secure-store"
    ]
  }
}
