# Phoenix door backend configuration. Copy to .env and fill in.

# Postgres connection (one or the other)
DATABASE_URL=postgres://phx:phx@localhost:5432/phx_door
# PGHOST=localhost
# PGPORT=5432
# PGUSER=phx
# PGPASSWORD=phx
# PGDATABASE=phx_door

# HTTP
PORT=4000

# Auth (admin/mobile JWTs). MUST be set and kept stable; rotating it logs everyone out.
JWT_SECRET=change-me-to-a-long-random-string

# First admin, seeded by `npm run seed-admin` (never hard-coded in SQL).
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@phoenixsectech.com
SEED_ADMIN_PASSWORD=change-me

# Rotating phone-token lifetime (seconds). Short = more replay-resistant.
PHONE_TOKEN_TTL=180
