<?xml version="1.0" encoding="utf-8"?>
<!-- Registers our proprietary AID so Android routes the reader's APDUs to
     DoorHceService. AID = F0 + "PHXDOOR" (F0-prefixed = proprietary). The door
     firmware SELECTs this exact AID. -->
<host-apdu-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/hce_service_desc"
    android:requireDeviceUnlock="false">
    <aid-group
        android:description="@string/hce_aid_group_desc"
        android:category="other">
        <aid-filter android:name="F0504858444F4F52" />
    </aid-group>
</host-apdu-service>
